@baseUrl = http://127.0.0.1:8000/api

### Health check
GET {{baseUrl}}/health

### Public zones
GET {{baseUrl}}/zones

### Auth register (stabil JSON válasz)
POST {{baseUrl}}/auth/register
Accept: application/json
Content-Type: application/json

{
  "name": "Teszt Elek",
  "email": "teszt_uj@example.com",
  "password": "Password123",
  "password_confirmation": "Password123"
}

### Auth login (email/password helyére írj érvényes felhasználót)
@authToken = 96|158cahpNEfiBDN8PuEJ50vsTkdfyDy4B3JmEHd4y1ad7ac62

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "teszt_uj@example.com",
  "password": "Password123"
}

### Auth me (fejlécekbe token behelyettesítéssel)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### Auth logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{authToken}}

### Auth tokens - list current user's devices/tokens
GET {{baseUrl}}/auth/tokens
Authorization: Bearer {{authToken}}
Accept: application/json

### Auth tokens - revoke one token by id
DELETE {{baseUrl}}/auth/tokens/1
Authorization: Bearer {{authToken}}
Accept: application/json

### Auth logout all devices
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{authToken}}
Accept: application/json

### Zones - create
POST {{baseUrl}}/zones
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Zone B",
  "price_per_minute": 5,
  "max_parking_minutes": 120
}

### Zones - update
PUT {{baseUrl}}/zones/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Zona A1",
  "price_per_minute": 6,
  "max_parking_minutes": 150
}

### Zones - delete
DELETE {{baseUrl}}/zones/1
Authorization: Bearer {{authToken}}

### Vehicles - list
GET {{baseUrl}}/vehicles
Authorization: Bearer {{authToken}}

### Vehicles - create
POST {{baseUrl}}/vehicles
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "plate_number": "ABC-123",
  "make": "Toyota",
  "model": "Corolla"
}

### Vehicles - show
GET {{baseUrl}}/vehicles/1
Authorization: Bearer {{authToken}}

### Vehicles - update
PUT {{baseUrl}}/vehicles/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "make": "Toyota",
  "model": "Camry"
}

### Vehicles - delete
DELETE {{baseUrl}}/vehicles/1
Authorization: Bearer {{authToken}}

### Tickets - list
GET {{baseUrl}}/tickets
Authorization: Bearer {{authToken}}

### Tickets - create
POST {{baseUrl}}/tickets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "vehicle_id": 1,
  "zone_id": 1,
  "minutes": 60
}

### Tickets - extend
POST {{baseUrl}}/tickets/1/extend
Authorization: Bearer {{authToken}}
Accept: application/json
Content-Type: application/json

{
  "minutes": 30
}

### Fines - list (user-facing)
GET {{baseUrl}}/fines
Authorization: Bearer {{authToken}}

### Officer fines - list
GET {{baseUrl}}/officer/fines
Authorization: Bearer {{authToken}}

### Officer fines - issue
POST {{baseUrl}}/officer/fines
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "vehicle_id": 1,
  "amount": 500,
  "reason": "tiltott parkolás"
}

### Officer lookup by plate
GET {{baseUrl}}/officer/lookup?plate=ABC-123
Authorization: Bearer {{authToken}}

### Admin stats
GET {{baseUrl}}/admin/stats
Authorization: Bearer {{authToken}}

### Pay fine
POST {{baseUrl}}/fines/1/pay
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "payment_method": "card"
}

### Users - list
GET {{baseUrl}}/users
Authorization: Bearer {{authToken}}

### Users - create
POST {{baseUrl}}/users
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Felhasználó",
  "email": "user@example.com",
  "password": "password",
  "role": "user"
}

### Users - update
PUT {{baseUrl}}/users/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Felhasználó Módosítva",
  "role": "officer"
}
